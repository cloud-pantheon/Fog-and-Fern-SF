<div class="admin-card"><div class="admin-card-head"><h2>Contact messages</h2><span><%= messages.length %> total</span></div><% if(!messages.length){ %><p>No messages yet.</p><% } %><% messages.forEach(m=>{ %><article class="message-card <%= m.status==='New'?'unread':'' %>"><div><h3><%= m.subject %></h3><span><%= m.name %> · <a href="mailto:<%= m.email %>"><%= m.email %></a> · <%= new Date(m.created_at).toLocaleString() %></span><p><%= m.message %></p></div><% if(m.status==='New'){ %><form action="/admin/messages/<%= m.id %>/read" method="post"><button class="btn-dark">Mark read</button></form><% }else{ %><span class="status">Read</span><% } %></article><% }) %></div>
