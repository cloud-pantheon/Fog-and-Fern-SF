<div class="admin-card"><div class="admin-card-head"><div><h2>Products</h2><p>Manage inventory, pricing, visibility, and featured items.</p></div><a class="btn-green" href="/admin/products/new">Add product</a></div><div class="table-responsive"><table class="data-table"><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th>Actions</th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><div class="table-product"><img src="<%= p.image_url || 'https://placehold.co/100' %>" alt=""><div><strong><%= p.name %></strong><small><%= p.featured?'Featured':'' %></small></div></div></td><td><%= p.category_name||'Uncategorized' %></td><td>$<%= (p.sale_price||p.price).toFixed(2) %></td><td><span class="<%= p.stock<=5?'text-danger fw-bold':'' %>"><%= p.stock %></span></td><td><span class="status"><%= p.active?'Active':'Hidden' %></span></td><td><a href="/admin/products/<%= p.id %>/edit">Edit</a> · <form class="inline" action="/admin/products/<%= p.id %>/delete" method="post" onsubmit="return confirm('Delete this product?')"><button class="danger-link">Delete</button></form></td></tr><% }) %></tbody></table></div></div>
