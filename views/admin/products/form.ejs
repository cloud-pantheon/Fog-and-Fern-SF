<div class="admin-card"><div class="admin-card-head"><h2><%= product?'Edit product':'Add product' %></h2><a href="/admin/products">Back to products</a></div><form action="<%= product?'/admin/products/'+product.id:'/admin/products' %>" method="post" enctype="multipart/form-data" class="form-grid"><label>Name<input name="name" required value="<%= product?.name||'' %>"></label><label>Category<select name="category_id"><option value="">Uncategorized</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= product?.category_id===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></label><label>Price<input type="number" step="0.01" min="0" name="price" required value="<%= product?.price??'' %>"></label><label>Sale price<input type="number" step="0.01" min="0" name="sale_price" value="<%= product?.sale_price??'' %>"></label><label>Stock<input type="number" min="0" name="stock" value="<%= product?.stock??0 %>"></label><label>Difficulty<input name="difficulty" value="<%= product?.difficulty||'' %>" placeholder="Beginner"></label><label>Light requirement<input name="light_requirement" value="<%= product?.light_requirement||'' %>"></label><label>Water requirement<input name="water_requirement" value="<%= product?.water_requirement||'' %>"></label><label class="wide">Image URL<input name="image_url" value="<%= product?.image_url||'' %>" placeholder="https://..."></label><label class="wide">Or upload image<input type="file" name="image" accept="image/*"></label><label class="wide">Description<textarea name="description" rows="6" required><%= product?.description||'' %></textarea></label><label class="check"><input type="checkbox" name="pet_safe" <%= product?.pet_safe?'checked':'' %>> Pet friendly</label><label class="check"><input type="checkbox" name="featured" <%= product?.featured?'checked':'' %>> Featured</label><label class="check"><input type="checkbox" name="active" <%= product?product.active?'checked':'':'checked' %>> Active</label><div class="wide"><button class="btn-green">Save product</button></div></form></div>
