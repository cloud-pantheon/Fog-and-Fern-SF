<div class="admin-grid-two"><div class="admin-card"><div class="admin-card-head"><h2><%= order.order_number %></h2><a href="/admin/orders">Back</a></div><p><strong><%= order.customer_name %></strong><br><%= order.email %> · <%= order.phone %></p><p><%= order.fulfillment==='delivery'?[order.address,order.city,order.zip_code].filter(Boolean).join(', '):'Store pickup' %></p><p>Payment: <%= order.payment_method %></p><% if(order.notes){ %><p>Notes: <%= order.notes %></p><% } %><form action="/admin/orders/<%= order.id %>/status" method="post"><label>Status<select name="status"><% ['Pending','Confirmed','Preparing','Ready','Out for Delivery','Completed','Cancelled'].forEach(s=>{ %><option <%= order.status===s?'selected':'' %>><%= s %></option><% }) %></select></label><button class="btn-green mt-3">Update status</button></form></div><div class="admin-card"><h2>Order items</h2><% items.forEach(i=>{ %><div class="order-item-line"><span><%= i.product_name %> × <%= i.quantity %></span><strong>$<%= i.line_total.toFixed(2) %></strong></div><% }) %><hr><div class="order-item-line"><span>Subtotal</span><strong>$<%= order.subtotal.toFixed(2) %></strong></div><div class="order-item-line"><span>Delivery</span><strong>$<%= order.delivery_fee.toFixed(2) %></strong></div><div class="order-item-line total"><span>Total</span><strong>$<%= order.total.toFixed(2) %></strong></div></div></div>
