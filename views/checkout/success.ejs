<section class="confirmation-page">
  <div class="leaf-confetti" aria-hidden="true"><span>🌿</span><span>🍃</span><span>🌱</span><span>🍃</span><span>🌿</span><span>🌱</span></div>
  <div class="container confirmation-shell">
    <header class="confirmation-hero premium-card">
      <div class="success-mark"><i class="fa-solid fa-check"></i></div>
      <span class="eyebrow">Order confirmed</span>
      <h1>Thank you, <%= order.customer_name.split(' ')[0] %>!</h1>
      <p>Your plants are being prepared with care.</p>
      <div class="order-meta"><strong>Order <%= order.order_number %></strong><span>•</span><span><%= new Date(order.created_at + 'Z').toLocaleString('en-US',{month:'long',day:'numeric',year:'numeric'}) %></span></div>
      <div class="estimate"><i class="fa-solid <%= order.fulfillment === 'pickup' ? 'fa-store' : 'fa-truck-fast' %>"></i><div><small>Estimated <%= order.fulfillment %></small><strong><%= order.fulfillment === 'pickup' ? 'Today • 3:00 PM' : 'Tomorrow • 10:00 AM' %></strong></div></div>
    </header>

    <div class="confirmation-grid">
      <div class="confirmation-main">
        <section class="premium-card receipt-card">
          <div class="card-title"><div><span class="eyebrow">Purchase summary</span><h2>Your plants</h2></div><i class="fa-solid fa-seedling"></i></div>
          <div class="receipt-products">
            <% items.forEach(item => { %><article class="receipt-product"><img src="<%= item.image_url || 'https://images.unsplash.com/photo-1485955900006-10f4d324d411?auto=format&fit=crop&w=300&q=80' %>" alt="<%= item.product_name %>"><div><h3><%= item.product_name %></h3><p>Quantity: <%= item.quantity %> · $<%= item.unit_price.toFixed(2) %> each</p></div><strong>$<%= item.line_total.toFixed(2) %></strong></article><% }) %>
          </div>
          <div class="receipt-totals"><div><span>Subtotal</span><b>$<%= order.subtotal.toFixed(2) %></b></div><div><span>San Francisco tax</span><b>$<%= (order.tax || 0).toFixed(2) %></b></div><div><span>Delivery</span><b><%= order.delivery_fee ? '$' + order.delivery_fee.toFixed(2) : 'Free' %></b></div><div class="grand-total"><span>Total</span><b>$<%= order.total.toFixed(2) %></b></div></div>
        </section>

        <section class="premium-card timeline-card"><span class="eyebrow">Order journey</span><h2>What happens next</h2><div class="order-timeline"><div class="done"><i class="fa-solid fa-check"></i><span>Order placed</span></div><div class="done"><i class="fa-solid fa-check"></i><span>Payment received</span></div><div class="active"><i class="fa-solid fa-seedling"></i><span>Preparing plants</span></div><div><i class="fa-solid fa-box"></i><span>Ready for <%= order.fulfillment %></span></div><div><i class="fa-solid fa-house"></i><span>Completed</span></div></div></section>
      </div>

      <aside class="confirmation-side">
        <section class="premium-card payment-card"><div class="payment-success-icon"><i class="fa-solid fa-credit-card"></i></div><span class="eyebrow">Payment successful</span><h2><%= order.card_brand ? order.card_brand.charAt(0)+order.card_brand.slice(1).toLowerCase() : (order.payment_method === 'Square card' ? 'Card' : order.payment_method) %> <%= order.card_last_four ? '•••• ' + order.card_last_four : '' %></h2><p><%= order.payment_method === 'Square card' ? 'Paid securely with Square' : order.payment_method %></p><div class="payment-date"><span><%= new Date(order.created_at + 'Z').toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}) %></span><span><%= new Date(order.created_at + 'Z').toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'}) %></span></div><div class="paid-badge"><span></span><%= order.payment_status === 'COMPLETED' ? 'Paid' : order.payment_status %></div></section>

        <section class="premium-card location-card"><i class="fa-solid fa-location-dot"></i><span class="eyebrow"><%= order.fulfillment === 'pickup' ? 'Pickup location' : 'Delivering to' %></span><h2><%= order.fulfillment === 'pickup' ? 'Fog & Fern' : order.customer_name %></h2><p><%= order.fulfillment === 'pickup' ? '1455 Market Street<br>San Francisco, CA<br><small>Open 10 AM – 6 PM</small>' : `${order.address}<br>${order.city}, CA ${order.zip_code}` %></p></section>

        <section class="premium-card notice-card"><i class="fa-regular fa-envelope"></i><h3>Confirmation sent</h3><p>A confirmation email has been sent to <strong><%= order.email %></strong></p><small>Need help? <a href="mailto:support@fogandfern.com">support@fogandfern.com</a></small></section>
      </aside>
    </div>

    <div class="confirmation-actions"><a href="/shop" class="btn-premium secondary"><i class="fa-solid fa-bag-shopping"></i> Continue shopping</a><a href="/account/orders" class="btn-premium secondary"><i class="fa-solid fa-box"></i> My orders</a><a href="/checkout/receipt/<%= order.id %>" class="btn-premium"><i class="fa-solid fa-receipt"></i> View branded receipt</a><a href="mailto:<%= order.email %>?subject=Fog%20%26%20Fern%20Receipt%20<%= order.order_number %>&body=Your%20receipt:%20<%= encodeURIComponent(receiptUrl) %>" class="btn-premium secondary"><i class="fa-regular fa-envelope"></i> Email receipt</a></div>
  </div>
</section>
