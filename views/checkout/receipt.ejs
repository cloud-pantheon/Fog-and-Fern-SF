<section class="branded-receipt-page"><div class="container receipt-page-shell">
  <div class="receipt-toolbar no-print"><a href="/account/orders/<%= order.id %>">← Back to order details</a><div><button onclick="window.print()" class="btn-premium secondary"><i class="fa-solid fa-print"></i> Print receipt</button><button onclick="window.print()" class="btn-premium"><i class="fa-solid fa-file-pdf"></i> Download PDF</button></div></div>
  <article class="branded-receipt">
    <header class="receipt-brand"><div class="receipt-logo"><i class="fa-solid fa-leaf"></i></div><div><h1>FOG &amp; FERN</h1><p>San Francisco Plant Shop</p></div><span>RECEIPT</span></header>
    <div class="receipt-info-grid"><div><small>Order number</small><strong><%= order.order_number %></strong></div><div><small>Date</small><strong><%= new Date(order.created_at+'Z').toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit'}) %></strong></div><div><small>Customer</small><strong><%= order.customer_name %></strong><span><%= order.email %></span></div><div><small>Fulfillment</small><strong><%= order.fulfillment.charAt(0).toUpperCase()+order.fulfillment.slice(1) %></strong><span><%= order.fulfillment==='pickup'?'1455 Market Street, San Francisco':`${order.address}, ${order.city}, CA ${order.zip_code}` %></span></div></div>
    <div class="receipt-table"><div class="receipt-table-head"><span>Item</span><span>Qty</span><span>Price</span><span>Total</span></div><% items.forEach(item=>{ %><div class="receipt-table-row"><div><img src="<%= item.image_url %>" alt=""><strong><%= item.product_name %></strong></div><span><%= item.quantity %></span><span>$<%= item.unit_price.toFixed(2) %></span><b>$<%= item.line_total.toFixed(2) %></b></div><% }) %></div>
    <div class="receipt-bottom"><div class="receipt-payment-block"><small>Payment status</small><div class="paid-badge"><span></span><%= order.payment_status==='COMPLETED'?'Paid':order.payment_status %></div><p><%= order.card_brand || order.payment_method %> <%= order.card_last_four ? '•••• '+order.card_last_four : '' %><br><small>Processed securely<%= order.payment_method==='Square card'?' by Square':'' %></small></p></div><div class="receipt-amounts"><div><span>Subtotal</span><b>$<%= order.subtotal.toFixed(2) %></b></div><div><span>Tax</span><b>$<%= (order.tax||0).toFixed(2) %></b></div><div><span>Delivery</span><b><%= order.delivery_fee?'$'+order.delivery_fee.toFixed(2):'Free' %></b></div><div class="grand-total"><span>Total</span><b>$<%= order.total.toFixed(2) %></b></div></div></div>
    <footer class="receipt-footer"><div><img class="receipt-qr" src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=<%= encodeURIComponent(receiptUrl) %>" alt="Order QR code"><small>Scan to view this receipt</small></div><div><h2>Thank you for growing with us. 🌿</h2><p>Fog &amp; Fern · 1455 Market Street · San Francisco, CA<br>support@fogandfern.com · Open daily 10 AM – 6 PM</p></div></footer>
  </article>
</div></section>
